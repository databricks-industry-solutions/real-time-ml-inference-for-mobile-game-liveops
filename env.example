# Deployment configuration. Copy to `.env` (git-ignored), fill in, then load it into
# your shell before any databricks / provisioning command:
#
#   cp env.example .env && $EDITOR .env
#   set -a && source .env && set +a
#
# BUNDLE_VAR_<name> sets the bundle variable <name> (databricks.yml); the Databricks
# CLI reads these natively.

# ---- Workspace ---------------------------------------------------------------
# CLI profile from ~/.databrickscfg (or set DATABRICKS_HOST + auth instead).
DATABRICKS_CONFIG_PROFILE=

# ---- Unity Catalog -------------------------------------------------------------
# REQUIRED: an existing catalog you can create schemas in.
BUNDLE_VAR_catalog=
# BUNDLE_VAR_schema=offer_recommender
# BUNDLE_VAR_prefix=offer-reco

# ---- GPU training (Databricks AI Runtime) ----------------------------------------
# Defaults: 1 x GPU_1xA10, 40 epochs. Multi-node example: 16 + GPU_8xH100 (2 nodes).
# BUNDLE_VAR_train_gpus=1
# BUNDLE_VAR_gpu_accelerator_type=GPU_1xA10
# BUNDLE_VAR_train_epochs=40

# ---- Real-time events: Azure Event Hubs (REQUIRED) ------------------------------
# Used by provisioning/provision_eventhub.sh, then provisioning/provision_databricks.sh
# (see docs/DEPLOYMENT.md for the order).
EH_NAMESPACE=evhns-offer-reco-<unique-suffix>
# EH_RESOURCE_GROUP=rg-offer-recommender
# EH_LOCATION=eastus
# EH_TAGS="project=offer-recommender owner=you@example.com"
BUNDLE_VAR_kafka_bootstrap=${EH_NAMESPACE}.servicebus.windows.net:9093
BUNDLE_VAR_kafka_uc_connection=eventhub_offer_reco
# Producer logins/sec; keep under ~200 unless the ranking endpoint is route-optimized.
# BUNDLE_VAR_login_rate=150

# ---- Optional ------------------------------------------------------------------
# SQL warehouse for the local jobs/smoke_serving_inference.py helper only.
# RECO_WAREHOUSE_ID=
# PyPI mirror, if public PyPI is blocked on your network (`uv build` needs one).
# UV_INDEX_URL=
